{
  "name": "@chatbot/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile main.worker",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "verify:isolation": "node scripts/verify-tenant-isolation.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@chatbot/contracts": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@node-rs/argon2": "^2.0.2",
    "bullmq": "^6.0.6",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.11.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.7",
    "mammoth": "^1.12.0",
    "openai": "^7.4.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "unpdf": "^1.8.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@chatbot/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.47",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
  }
}
