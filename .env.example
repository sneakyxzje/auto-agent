
NODE_ENV=development
API_PORT=3001
# --- PostgreSQL ------------------------------------------------------------
# POSTGRES_* dùng để khởi tạo container lần đầu.
POSTGRES_USER=chatbot
POSTGRES_DB=chatbot
POSTGRES_PASSWORD=chatbot_dev_password

POSTGRES_HOST_PORT=5432

# Ba chuỗi kết nối cho ba việc khác nhau. POSTGRES_USER là superuser nên xuyên
# qua được Row-Level Security — vì vậy nó CHỈ được dùng để chạy migration.
#
#   DATABASE_URL            nghiệp vụ, bị RLS chặn theo tenant
#   DATABASE_AUTH_URL       chỉ đăng ký/đăng nhập, lúc chưa biết tenant nào
#   DATABASE_MIGRATION_URL  chỉ chạy migration
APP_DB_PASSWORD=chatbot_app_dev_password
AUTH_DB_PASSWORD=chatbot_auth_dev_password

DATABASE_URL=postgres://chatbot_app:chatbot_app_dev_password@postgres:5432/chatbot
DATABASE_AUTH_URL=postgres://chatbot_auth:chatbot_auth_dev_password@postgres:5432/chatbot
DATABASE_MIGRATION_URL=postgres://chatbot:chatbot_dev_password@postgres:5432/chatbot

# --- Redis: broker BullMQ, channel layer WS, bộ đếm rate limit --------------
REDIS_URL=redis://redis:6379

# Cổng phía host. Đổi sang 6380 nếu máy đã có Redis riêng chiếm 6379.
REDIS_HOST_PORT=6379

# --- Khóa chung với hệ thống chủ để verify JWT -----------------------------
JWT_SECRET=doi_gia_tri_nay_truoc_khi_len_prod_toi_thieu_32_ky_tu

# --- Lưu file: MinIO ở dev, S3 ở prod, chỉ đổi endpoint --------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=chatbot
S3_ACCESS_KEY=chatbot
S3_SECRET_KEY=chatbot_dev_password

# --- LLM: đổi mấy dòng này là chuyển sang Ollama / vLLM --------------------
# Ollama: LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_BIG=
LLM_MODEL_SMALL=
LLM_MODEL_VISION=

# --- Embedding -------------------------------------------------------------
# EMBEDDING_DIMENSIONS phải khớp hằng số cùng tên trong src/db/schema/chunk.ts.
# Đổi nó là phải migrate cột vector và tính lại embedding cho toàn kho.
EMBEDDING_BASE_URL=http://embed:80/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

# --- Ký webhook gửi ra hệ thống chủ ----------------------------------------
WEBHOOK_SECRET=

NEXT_PUBLIC_API_URL=/api
