# Sao chép thành `.env.local` khi chạy api/console trên máy thật nhưng dùng hạ
# tầng trong Docker:
#
#     docker compose up -d postgres redis minio
#     pnpm dev
#
# Thêm `embed` vào lệnh trên nếu quay về embedding self-host thay vì OpenAI, rồi
# bỏ comment dòng EMBEDDING_BASE_URL ở cuối file.
#
# File này nạp trước `.env` nên đè lên nó. Nhờ vậy `.env` giữ nguyên tên service
# cho container, còn đây trỏ localhost — không phải sửa qua sửa lại.
# Không commit, không vào image Docker.

# Cổng phải khớp POSTGRES_HOST_PORT trong `.env`.
DATABASE_URL=postgres://chatbot:chatbot_dev_password@localhost:5433/chatbot

REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000

# Chỉ cần khi chạy embedding self-host (service `embed`).
# EMBEDDING_BASE_URL=http://localhost:8080/v1
